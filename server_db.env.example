# server_db's settings. Copy to certificates/server_db.env and `chmod 600` it; it never goes in git.
# Values with $, ! or spaces go in single quotes.

# The VM's address on Proxmox's private bridge: what apps connect to. Never a public address.
SDB_BIND=10.10.10.20
# Where the data lives: the VM's data disk, mounted here.
SDB_DATA=/srv/server-db/data
# MongoDB's cache, in GB: about half the VM's memory less 1 GB. 1.5 on a 4 GB VM.
SDB_CACHE_GB=1.5
# The administrator, made on the first start. A password: openssl rand -hex 24
SDB_ROOT_USER=admin
SDB_ROOT_PASSWORD=
# A backup reports a failure when the data disk is this full, in percent: the warning before it is full.
SDB_DISK_ALERT=85

# ── off-site backups: restic, to a Cloudflare R2 bucket (any S3-compatible store works) ──────────
RESTIC_REPOSITORY=s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/server-db-backups
# R2 → Manage API tokens → "Object Read & Write", for this bucket only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# Encrypts every backup. Lose it and no backup can be read: keep a copy in your password manager.
# Make one: openssl rand -base64 36
RESTIC_PASSWORD=

# ── alerts: healthchecks.io (free) emails you when a job reports a failure or goes quiet ───────────
# One check per job: "backup", period 1 hour, grace 30 minutes; "drill", period 1 week, grace 1 day.
# Empty: no alerts, and nobody hears about a backup that stopped.
SDB_PING_BACKUP=
SDB_PING_DRILL=
