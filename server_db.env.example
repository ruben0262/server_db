# server_db's settings. Copy to certificates/server_db.env and `chmod 600` it; it never goes in git.
# Values with $, ! or spaces go in single quotes.

# The VM's own address on the LAN, fixed (a DHCP reservation on the router, or set in the VM): every
# machine on 192.168.50.x connects to it. Never a public address, and never forwarded by the router.
SDB_BIND=192.168.50.20
# Optional: a name for it on the LAN (a router DNS entry, or /etc/hosts on each machine), put in the
# MONGODB_URI that add-app prints. Empty: the address above.
SDB_HOSTNAME=
# Where the data lives: the VM's data disk, mounted here.
SDB_DATA=/srv/server-db/data
# MongoDB's cache, in GB: about half the VM's memory less 0.5 GB. 3.5 on an 8 GB VM (recommended,
# DESIGN.md "Speed"), 1.5 on a 4 GB one.
SDB_CACHE_GB=3.5
# The administrator, made on the first start. A password: openssl rand -hex 24
SDB_ROOT_USER=admin
SDB_ROOT_PASSWORD=
# A backup reports a failure when the data disk is this full, in percent: the warning before it is full.
SDB_DISK_ALERT=85

# ── backups: restic, hourly (DESIGN.md, "Backups") ─────────────────────────────────────────────
# Where every backup goes first, and what the drill restores from. Any one of:
#   a disk of its own on this VM, not the data disk:  /srv/server-db-backups
#   another machine on the LAN, over SSH:              sftp:backup@192.168.50.30:/backups/server-db
#   an S3 bucket (R2, B2, AWS):                        s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/server-db-backups
RESTIC_REPOSITORY=/srv/server-db-backups
# Optional: a second place each backup is copied to, after the first. Recommended: off the premises,
# when the first is not. Empty: no copy.
SDB_OFFSITE_REPOSITORY=
# For whichever of the two is an S3 bucket. R2 → Manage API tokens → "Object Read & Write", this bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
# Encrypts every backup, in both places. Lose it and no backup can be read: keep a copy in your password
# manager. Make one: openssl rand -base64 36
RESTIC_PASSWORD=

# ── alerts: healthchecks.io (free) emails you when a job reports a failure or goes quiet ───────────
# One check per job: "backup", period 1 hour, grace 30 minutes; "drill", period 1 week, grace 1 day.
# Empty: no alerts, and nobody hears about a backup that stopped.
SDB_PING_BACKUP=
SDB_PING_DRILL=
